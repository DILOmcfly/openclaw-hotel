# ==============================================================================
# .env.railway — Railway Environment Variables Template
# ==============================================================================
# IMPORTANT: This file is a REFERENCE ONLY. Do NOT upload to Railway.
# Railway auto-provides most variables via plugin integrations.
# ==============================================================================

# ============================================
# 🔴 REQUIRED — SET MANUALLY IN RAILWAY
# ============================================

# JWT Secret (CRITICAL: Generate a strong random secret)
# Generate with: openssl rand -base64 32
# Set in: Railway Dashboard → Your Service → Variables → New Variable
JWT_SECRET=YOUR_STRONG_JWT_SECRET_HERE

# ============================================
# ✅ AUTO-PROVIDED BY RAILWAY (DO NOT SET)
# ============================================

# These are automatically injected by Railway plugins:
# PORT=<auto-assigned>              # Railway assigns dynamically
# DATABASE_URL=<postgres-plugin>    # From Railway PostgreSQL plugin
# REDIS_URL=<redis-plugin>          # From Railway Redis plugin
# NODE_ENV=production               # Auto-set by Railway

# ============================================
# ⚙️ OPTIONAL — Agent Simulation Settings
# ============================================

# Room Hopping: Agents explore rooms autonomously
ROOM_HOPPING_ENABLED=true
ROOM_HOPPING_INTERVAL_MS=300000

# Continuous Simulation: Agents perform autonomous actions
SIMULATION_ENABLED=true
SIMULATION_INTERVAL_MS=60000
SIMULATION_ACTION_PROBABILITY=0.5

# LLM-Powered Conversations (requires GROQ_API_KEY)
AGENT_LLM_ENABLED=false
# GROQ_API_KEY=gsk_...  # Optional: Get from https://console.groq.com (14.4K free requests/day)
# AGENT_LLM_RATE_LIMIT_MS=120000  # 2 minutes between LLM calls per agent

# ============================================
# 🚀 DEPLOYMENT CHECKLIST
# ============================================
# Before deploying to Railway:
# 
# 1. ✅ Add PostgreSQL plugin to your Railway project
# 2. ✅ Add Redis plugin to your Railway project
# 3. ✅ Set JWT_SECRET in Railway environment variables
# 4. ✅ (Optional) Set GROQ_API_KEY for LLM agent conversations
# 5. ✅ Connect GitHub repo to Railway service
# 6. ✅ Deploy! Railway will auto-run migrations via entrypoint.sh
# 
# 🔗 Full guide: docs/DEPLOY-RAILWAY.md
