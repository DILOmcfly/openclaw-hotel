NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://openclaw:openclaw@localhost:5432/openclaw_hotel
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-strong-secret
POSTGRES_DB=openclaw_hotel
POSTGRES_USER=openclaw
POSTGRES_PASSWORD=openclaw

# === Autonomous Agent Services ===

# Room Hopping: Agents explore rooms periodically
ROOM_HOPPING_ENABLED=true
ROOM_HOPPING_INTERVAL_MS=300000  # 5 minutes

# Continuous Simulation: Agents act autonomously (move, chat, emote)
SIMULATION_ENABLED=true
SIMULATION_INTERVAL_MS=60000  # 60 seconds (1 minute)
SIMULATION_ACTION_PROBABILITY=0.5  # 50% chance an agent acts per tick
