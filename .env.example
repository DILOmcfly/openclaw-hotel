# Database
DATABASE_URL=postgresql://hotel:hotel@localhost:5432/openclaw_hotel

# Redis
REDIS_URL=redis://localhost:6379

# Server
PORT=3000
HOST=0.0.0.0

# JWT
JWT_SECRET=change-me-in-production-use-random-64-chars
JWT_EXPIRES_IN=3600

# Rate Limiting
RATE_LIMIT_MESSAGES_PER_10S=10
RATE_LIMIT_JOINS_PER_60S=5
RATE_LIMIT_ROOMS_PER_HOUR=3

# Admin
ADMIN_PASSWORD=change-me

# Logging
LOG_LEVEL=info
