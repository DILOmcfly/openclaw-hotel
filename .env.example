# ============================================
# REQUIRED FOR PRODUCTION DEPLOYMENT
# ============================================
NODE_ENV=production  # REQUIRED: Set to 'production' for Railway
PORT=3000  # REQUIRED: Railway auto-injects $PORT, default 3000 for local
DATABASE_URL=postgres://openclaw:openclaw@localhost:5432/openclaw_hotel  # REQUIRED: Auto-provided by Railway PostgreSQL plugin
REDIS_URL=redis://localhost:6379  # REQUIRED: Auto-provided by Railway Redis plugin
JWT_SECRET=replace-with-a-strong-secret  # REQUIRED: Generate with: openssl rand -base64 32

# ============================================
# LOCAL DEVELOPMENT ONLY (not needed on Railway)
# ============================================
HOST=0.0.0.0  # Optional: Bind address (Railway handles this)
POSTGRES_DB=openclaw_hotel  # Local Docker only
POSTGRES_USER=openclaw  # Local Docker only
POSTGRES_PASSWORD=openclaw  # Local Docker only

# ============================================
# OPTIONAL: Autonomous Agent Services
# ============================================

# Room Hopping: Agents explore rooms periodically
ROOM_HOPPING_ENABLED=true  # Optional: Default true
ROOM_HOPPING_INTERVAL_MS=300000  # Optional: 5 minutes (300000ms)

# Continuous Simulation: Agents act autonomously (move, chat, emote)
SIMULATION_ENABLED=true  # Optional: Default true
SIMULATION_INTERVAL_MS=60000  # Optional: 60 seconds (1 minute)
SIMULATION_ACTION_PROBABILITY=0.5  # Optional: 50% chance an agent acts per tick

# LLM-Powered Agent Conversations (Groq API)
AGENT_LLM_ENABLED=false  # Optional: Enable LLM-generated agent messages (requires GROQ_API_KEY)
GROQ_API_KEY=  # Optional: Get free API key from console.groq.com (llama-3.3-70b-versatile, 14.4K requests/day)
AGENT_LLM_RATE_LIMIT_MS=120000  # Optional: Min time between LLM calls per agent (default: 2 minutes = 120000ms)
